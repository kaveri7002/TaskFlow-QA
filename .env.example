# Copy this file to .env and replace values for your machine.
SECRET_KEY=local-development-only-change-this-before-deploying
# Leave DATABASE_URL unset locally to use database/taskflow-local.db.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_MAX_AGE_SECONDS=86400
FLASK_DEBUG=true
